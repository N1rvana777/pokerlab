+#[cfg(test)]
+mod sparse_storage_plan_tests {
+    use super::*;
+    use crate::bet_size::BetSizeOptions;
+    use crate::{card_from_str, flop_from_str};
+
+    fn prepared(street: BoardState, expanded: bool, sparse: bool) -> PostFlopGame {
+        let cards = CardConfig {
+            range: ["AA:0.7,AKs:0.3,AQo:0.2".parse().unwrap(), "KK:0.4,KQs:0.8,QJs:0.2".parse().unwrap()],
+            flop: flop_from_str("9h8h2h").unwrap(),
+            turn: if street != BoardState::Flop { card_from_str("4s").unwrap() } else { NOT_DEALT },
+            river: if street == BoardState::River { card_from_str("3d").unwrap() } else { NOT_DEALT },
+        };
+        let bet: BetSizeOptions = ("50%", "").try_into().unwrap();
+        let tree = ActionTree::new(TreeConfig {
+            initial_state: street, starting_pot: 20, effective_stack: 20,
+            flop_bet_sizes: [bet.clone(), bet.clone()],
+            turn_bet_sizes: [bet.clone(), bet.clone()],
+            river_bet_sizes: [bet.clone(), bet],
+            ..Default::default()
+        }).unwrap();
+        let mut game = PostFlopGame::prepare_config(cards, tree, expanded).unwrap();
+        game.set_sparse_storage(sparse).unwrap();
+        game
+    }
+
+    #[test]
+    fn sparse_preallocation_plan_equals_built_arrays_on_all_starting_streets() {
+        for street in [BoardState::Flop, BoardState::Turn, BoardState::River] {
+            for expanded in [false, true] {
+                let dense = prepared(street, expanded, false).memory_plan(1);
+                let mut game = prepared(street, expanded, true);
+                let plan = game.memory_plan(1);
+                assert_eq!(plan[0], dense[0], "node arena must not change");
+                assert_eq!(&plan[5..], &dense[5..], "hard-lock plan must remain dense");
+                assert!(plan[1] <= dense[1] && plan[2] <= dense[2] && plan[3] <= dense[3]);
+                if street != BoardState::River { assert!(plan[1] < dense[1]); }
+                game.build_prepared().unwrap();
+                assert_eq!(plan[1], game.num_storage);
+                assert_eq!(plan[2], game.num_storage_ip);
+                assert_eq!(plan[3], game.num_storage_chance);
+                let words = 2 * plan[1] + plan[2] + plan[3];
+                assert_eq!(game.memory_usage(), (plan[0] + plan[4] + 4 * words, plan[0] + plan[4] + 2 * words));
+                assert!(game.set_sparse_storage(false).is_err(), "cannot change physical layout after build");
+                game.allocate_memory(true);
+                assert_eq!(game.storage1.len() as u64, 2 * plan[1]);
+                assert_eq!(game.storage2.len() as u64, 2 * plan[1]);
+                assert_eq!(game.storage_ip.len() as u64, 2 * plan[2]);
+                assert_eq!(game.storage_chance.len() as u64, 2 * plan[3]);
+            }
+        }
+    }
