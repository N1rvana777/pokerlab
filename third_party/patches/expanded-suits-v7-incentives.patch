+        assert!(game.set_bunching_effect(&bunching).unwrap_err().contains("sparse"));
+        game.allocate_memory(true);
+        let lock = vec![1.0; game.root().num_actions() * game.num_private_hands(0)];
+        assert!(std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
