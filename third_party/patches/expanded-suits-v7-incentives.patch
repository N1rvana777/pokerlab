+        })).is_err(), "partial hard locks invalidate the shared illegal-hand ghost");
+        #[cfg(feature = "bincode")]
+        assert!(bincode::encode_to_vec(&game, bincode::config::standard()).unwrap_err().to_string().contains("Sparse"));
+    }
