+        self.turn = checkpoint.turn;
+        self.river = checkpoint.river;
+        self.turn_swapped_suit = checkpoint.turn_swapped_suit;
+        self.turn_swap = checkpoint.turn_swap;
+        self.river_swap = checkpoint.river_swap;
+        self.total_bet_amount = checkpoint.total_bet_amount;
