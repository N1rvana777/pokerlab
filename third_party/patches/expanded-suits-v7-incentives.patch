+    #[test]
+    fn direct_positive_regrets_match_expansion_for_extremes_and_every_ghost_position() {
+        for hands in [1usize, 2, 7, 16, 31, 65] {
+            for first_invalid in 0..hands {
+                for rows in [1usize, 2, 5] {
+                    // Includes empty legal sets, leading/trailing ghosts and
+                    // scattered public-card conflicts within vector-width tails.
+                    let indices:Vec<u16>=(0..hands)
+                        .filter(|&h| h<first_invalid || (h>first_invalid && h%3==0))
+                        .map(|h|h as u16).collect();
+                    let values=[i16::MIN,-32767,-1,0,1,17,i16::MAX];
+                    let packed:Vec<i16>=(0..rows*(indices.len()+1))
+                        .map(|i|values[(i+first_invalid)%values.len()]).collect();
+                    let expected=expand(&packed,&indices,hands,rows);
+                    let mut actual=vec![MaybeUninit::uninit();hands*rows];
+                    positive_packed_regrets(&packed,&indices,hands,rows,&mut actual);
+                    for (value,&word) in actual.into_iter().zip(&expected.0) {
+                        assert_eq!(unsafe{value.assume_init()}.to_bits(),(word.max(0) as f32).to_bits());
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn sparse_views_round_trip_all_legal_values_and_row_ghosts() {
