+//! Owned scratch storage for DCFR. No TLS borrow survives a recursive call or Rayon join.
+//! Only idle buffers are cached; checked-out vectors have independent ownership.
+use std::{cell::RefCell, ops::{Deref, DerefMut}, slice};
+
+const F32_LIMIT: usize = 768 * 1024;
+const F64_LIMIT: usize = 256 * 1024;
+const MAX_ENTRIES: usize = 32;
+
+struct Pool<T> { buffers: Vec<Vec<T>>, bytes: usize }
+impl<T> Pool<T> {
+    const fn new() -> Self { Self { buffers: Vec::new(), bytes: 0 } }
+    fn take(&mut self, capacity: usize) -> Option<Vec<T>> {
+        // Exact capacities prevent a small recursive request from retaining an oversized buffer.
+        let index = self.buffers.iter().rposition(|v| v.capacity() == capacity)?;
+        let buffer = self.buffers.swap_remove(index);
+        self.bytes -= buffer.capacity() * std::mem::size_of::<T>();
+        Some(buffer)
+    }
+    fn put(&mut self, mut buffer: Vec<T>, limit: usize) {
+        buffer.clear();
+        let bytes = buffer.capacity().saturating_mul(std::mem::size_of::<T>());
+        if bytes == 0 || bytes > limit.saturating_sub(self.bytes) || self.buffers.len() >= MAX_ENTRIES { return; }
+        self.bytes += bytes;
+        self.buffers.push(buffer);
+    }
+}
+
+thread_local! {
+    static F32_POOL: RefCell<Pool<f32>> = RefCell::new(Pool::new());
+    static F64_POOL: RefCell<Pool<f64>> = RefCell::new(Pool::new());
+}
+
+pub(crate) trait ScratchFloat: Sized {
+    fn take(capacity: usize) -> Vec<Self>;
+    fn give(buffer: Vec<Self>);
+}
+macro_rules! cached_float {
+    ($ty:ty, $pool:ident, $limit:ident) => {
+        impl ScratchFloat for $ty {
+            #[inline]
+            fn take(capacity: usize) -> Vec<Self> {
+                $pool.try_with(|p| p.try_borrow_mut().ok().and_then(|mut p| p.take(capacity)))
+                    .ok().flatten().unwrap_or_else(|| Vec::with_capacity(capacity))
+            }
+            #[inline]
+            fn give(buffer: Vec<Self>) {
+                // During TLS destruction or unexpected reentry, free instead of panicking in Drop.
+                let _ = $pool.try_with(|p| {
+                    if let Ok(mut p) = p.try_borrow_mut() { p.put(buffer, $limit); }
+                });
+            }
+        }
+    };
+}
+cached_float!(f32, F32_POOL, F32_LIMIT);
+cached_float!(f64, F64_POOL, F64_LIMIT);
+
+pub(crate) struct Scratch<T: ScratchFloat>(Vec<T>);
+impl<T: ScratchFloat> Scratch<T> {
+    #[inline]
+    pub(crate) fn with_capacity(capacity: usize) -> Self { Self(T::take(capacity)) }
+}
+impl<T: ScratchFloat> Deref for Scratch<T> {
+    type Target = Vec<T>;
+    #[inline]
+    fn deref(&self) -> &Vec<T> { &self.0 }
+}
+impl<T: ScratchFloat> DerefMut for Scratch<T> {
+    #[inline]
+    fn deref_mut(&mut self) -> &mut Vec<T> { &mut self.0 }
+}
+impl<'a, T: ScratchFloat> IntoIterator for &'a Scratch<T> {
+    type Item = &'a T;
+    type IntoIter = slice::Iter<'a, T>;
+    fn into_iter(self) -> Self::IntoIter { self.0.iter() }
+}
+impl<T: ScratchFloat> Drop for Scratch<T> {
+    #[inline]
+    fn drop(&mut self) { T::give(std::mem::take(&mut self.0)); }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn exact_capacity_and_idle_bounds() {
+        let mut pool = Pool::<f32>::new();
+        pool.put(vec![1.0; 64], 1024);
+        assert!(pool.take(32).is_none());
+        let buffer = pool.take(64).unwrap();
+        assert_eq!(buffer.len(), 0);
+        assert_eq!(pool.bytes, 0);
+        pool.put(buffer, 1024);
+        pool.put(Vec::with_capacity(1024), 1024);
+        for _ in 0..100 { pool.put(Vec::with_capacity(1), 1024); }
+        assert!(pool.bytes <= 1024 && pool.buffers.len() <= MAX_ENTRIES);
+        assert_eq!(pool.bytes, pool.buffers.iter().map(|v| v.capacity() * 4).sum::<usize>());
+    }
+
+    #[test]
+    fn nested_owners_and_reuse_do_not_alias() {
+        let mut parent = Scratch::<f32>::with_capacity(203);
+        parent.resize(203, 7.0);
+        let pointer = parent.as_ptr();
+        {
+            let mut child = Scratch::<f32>::with_capacity(203);
+            child.resize(203, 9.0);
+            assert_ne!(pointer, child.as_ptr());
+            assert!(parent.iter().all(|&v| v == 7.0));
+        }
+        let mut child = Scratch::<f32>::with_capacity(203);
+        assert_eq!(child.len(), 0);
+        child.extend([2.0, 3.0]);
+        assert_eq!(child.as_slice(), &[2.0, 3.0]);
+        assert!(parent.iter().all(|&v| v == 7.0));
+        let mut wide = Scratch::<f64>::with_capacity(449);
+        wide.resize(449, 1.5);
+        assert_eq!(wide.len(), 449);
+    }
+
+    #[test]
+    fn borrowed_pool_drop_falls_back_without_panicking() {
+        let value = Scratch::<f32>::with_capacity(17);
+        F32_POOL.with(|pool| {
+            let _borrow = pool.borrow_mut();
+            let mut fallback = Scratch::<f32>::with_capacity(17);
+            fallback.extend([3.0, 4.0]);
+            assert_eq!(fallback.as_slice(), &[3.0, 4.0]);
+            drop(fallback);
+            drop(value);
+        });
+    }
+}
diff --git a/src/solver_scratch_tests.rs b/src/solver_scratch_tests.rs
new file mode 100644
index 0000000..08dd5d0
--- /dev/null
+++ b/src/solver_scratch_tests.rs
@@ -0,0 +1,317 @@
+//! Numerical equivalence of scratch reuse against the frozen, pre-optimization DCFR.
+//!
+//! The reference is compiled only in tests. This is an implementation regression,
+//! not a second poker evaluator or an independent proof of equilibrium correctness.
+//! Every compared buffer is initialized by allocate_memory before any read.
+
+use crate::*;
+
+#[path = "solver_reference.rs"]
+#[allow(dead_code)]
+mod reference;
+
+#[derive(Default, Debug)]
+struct ComparedNodes {
+    decision: usize,
+    chance: usize,
+    terminal: usize,
+    isomorphic: usize,
+    locked: usize,
+}
+
+fn equal_floats(a: &[f32], b: &[f32], label: &str) {
+    assert_eq!(a.len(), b.len(), "{label}: length");
+    for (index, (&x, &y)) in a.iter().zip(b).enumerate() {
+        assert!(x.is_finite() && y.is_finite(), "{label}[{index}]: nonfinite {x}/{y}");
+        assert_eq!(x.to_bits(), y.to_bits(), "{label}[{index}]: {x}/{y}");
+    }
+}
+
+fn compare_nodes(
+    a: &PostFlopGame,
+    b: &PostFlopGame,
+    left: &PostFlopNode,
+    right: &PostFlopNode,
+    path: &mut Vec<usize>,
+    counts: &mut ComparedNodes,
+) {
+    assert_eq!(left.is_terminal(), right.is_terminal(), "{path:?}");
+    assert_eq!(left.is_chance(), right.is_chance(), "{path:?}");
+    assert_eq!(left.num_actions(), right.num_actions(), "{path:?}");
+    if left.is_terminal() {
+        counts.terminal += 1;
+        // Terminal nodes deliberately have null storage pointers. Do not ask
+        // for even an empty storage slice, because from_raw_parts forbids null.
+        return;
+    }
+    let compressed = a.is_compression_enabled();
+    if left.is_chance() {
+        counts.chance += 1;
+        counts.isomorphic += a.isomorphic_chances(left).len();
+        assert_eq!(a.isomorphic_chances(left), b.isomorphic_chances(right));
+        assert_eq!(left.cfvalue_storage_player(), right.cfvalue_storage_player());
+        if compressed {
+            assert_eq!(&*dense_cfvalues_chance_compressed(a, left), &*dense_cfvalues_chance_compressed(b, right), "chance CFV {path:?}");
+            equal_floats(&[left.cfvalue_chance_scale()], &[right.cfvalue_chance_scale()], "chance scale");
+        } else {
+            equal_floats(&*dense_cfvalues_chance(a, left), &*dense_cfvalues_chance(b, right), "chance CFV");
+        }
+    } else {
+        counts.decision += 1;
+        assert_eq!(left.player(), right.player(), "{path:?}");
+        if !a.locking_strategy(left).is_empty() {
+            counts.locked += 1;
+        }
+        equal_floats(a.locking_strategy(left), b.locking_strategy(right), "lock");
+        if compressed {
+            assert_eq!(&*dense_strategy_compressed(a, left), &*dense_strategy_compressed(b, right), "strategy {path:?}");
+            // This same storage is regrets before finalize and action CFVs
+            // after finalize; both phases are compared by the caller.
+            assert_eq!(&*dense_regrets_compressed(a, left), &*dense_regrets_compressed(b, right), "regrets/CFV {path:?}");
+            equal_floats(&[left.strategy_scale(), left.regret_scale()], &[right.strategy_scale(), right.regret_scale()], "strategy/regret scales");
+        } else {
+            equal_floats(&*dense_strategy(a, left), &*dense_strategy(b, right), "strategy");
+            equal_floats(&*dense_regrets(a, left), &*dense_regrets(b, right), "regrets/CFV");
+        }
+        assert_eq!(left.has_cfvalues_ip(), right.has_cfvalues_ip());
+        if left.has_cfvalues_ip() {
+            if compressed {
+                assert_eq!(&*dense_cfvalues_ip_compressed(a, left), &*dense_cfvalues_ip_compressed(b, right), "IP CFV {path:?}");
+                equal_floats(&[left.cfvalue_ip_scale()], &[right.cfvalue_ip_scale()], "IP CFV scale");
+            } else {
+                equal_floats(&*dense_cfvalues_ip(a, left), &*dense_cfvalues_ip(b, right), "IP CFV");
+            }
+        }
+    }
+    for action in left.action_indices() {
+        path.push(action);
+        compare_nodes(a, b, &left.play(action), &right.play(action), path, counts);
+        path.pop();
+    }
+}
+
+fn compare_games(a: &PostFlopGame, b: &PostFlopGame) -> ComparedNodes {
+    assert_eq!(a.is_compression_enabled(), b.is_compression_enabled());
+    let mut counts = ComparedNodes::default();
+    compare_nodes(a, b, &a.root(), &b.root(), &mut Vec::new(), &mut counts);
+    counts
+}
+
+fn fixture(street: BoardState, compressed: bool, expanded_and_locked: bool) -> PostFlopGame {
+    fixture_storage(street, compressed, expanded_and_locked, false)
+}
+
+fn fixture_storage(street: BoardState, compressed: bool, expanded_and_locked: bool, sparse: bool) -> PostFlopGame {
+    let cards = CardConfig {
+        // Unequal hand counts and fractional weights stress reused scratch
+        // lengths. Monotone flop + suit-symmetric ranges exercise isomorphism.
+        range: ["AKs:0.7,QQ".parse().unwrap(), "QJs,KTs:0.3".parse().unwrap()],
+        flop: flop_from_str("2c3c4c").unwrap(),
+        turn: if street >= BoardState::Turn { card_from_str("7c").unwrap() } else { NOT_DEALT },
+        river: if street == BoardState::River { card_from_str("9h").unwrap() } else { NOT_DEALT },
+    };
+    let small_sizes: BetSizeOptions = ("50%,a", "2x").try_into().unwrap();
+    let river_sizes: BetSizeOptions = if street == BoardState::River {
+        ("25%,50%,100%", "2x").try_into().unwrap()
+    } else {
+        small_sizes.clone()
+    };
+    let tree = ActionTree::new(TreeConfig {
+        initial_state: street,
+        starting_pot: 20,
+        effective_stack: if street == BoardState::River { 60 } else { 12 },
+        flop_bet_sizes: [small_sizes.clone(), small_sizes.clone()],
+        turn_bet_sizes: [small_sizes.clone(), small_sizes],
+        river_bet_sizes: [river_sizes.clone(), river_sizes],
+        add_allin_threshold: 0.0,
+        force_allin_threshold: 0.0,
+        merging_threshold: 0.0,
+        ..Default::default()
+    }).unwrap();
+    let mut game = PostFlopGame::prepare_config(cards, tree, expanded_and_locked).unwrap();
+    game.set_sparse_storage(sparse).unwrap();
+    let plan=game.memory_plan(1);
+    game.build_prepared().unwrap();
+    assert_eq!(game.memory_usage().1, plan[0]+plan[4]+2*(2*plan[1]+plan[2]+plan[3]));
+    game.allocate_memory(compressed);
+    assert_ne!(game.num_private_hands(0), game.num_private_hands(1));
+    if expanded_and_locked {
+        // Root pure check leaves all aggressive branches at zero reach for
+        // OOP. They remain allocated and traversed: scratch must not contain
+        // stale values for those off-path branches or blocked future boards.
+        let hands = game.num_private_hands(0);
+        let actions = game.available_actions().len();
+        assert!(actions >= 3);
+        let mut lock = vec![0.0; actions * hands];
+        lock[..hands].fill(1.0);
+        game.lock_current_strategy(&lock);
+        // After check, mix IP's first two actions for half its combinations;
+        // leave the other half unlocked (-1 after lock API normalization).
+        game.play(0);
+        let hands = game.num_private_hands(1);
+        let actions = game.available_actions().len();
+        let mut lock = vec![0.0; actions * hands];
+        for hand in 0..hands / 2 {
+            lock[hand] = 0.375;
+            lock[hands + hand] = 0.625;
+        }
+        game.lock_current_strategy(&lock);
+        game.back_to_root();
+    }
+    game
+}
+
+fn compare_ev(a: &PostFlopGame, b: &PostFlopGame) {
+    equal_floats(&compute_current_ev(a), &compute_current_ev(b), "current EV");
+    equal_floats(&compute_mes_ev(a), &compute_mes_ev(b), "MES EV");
+    equal_floats(&[compute_exploitability(a)], &[compute_exploitability(b)], "exploitability");
+}
+
+#[cfg(feature = "rayon")]
+fn run_in_pool<T: Send>(pool: &rayon::ThreadPool, task: impl FnOnce() -> T + Send) -> T {
+    pool.install(task)
+}
+
+fn equivalence_case(street: BoardState, compressed: bool, locked: bool, threads: usize, iterations: &[u32]) {
+    let mut old = fixture(street, compressed, locked);
+    let mut new = fixture(street, compressed, locked);
+    #[cfg(feature = "rayon")]
+    let old_pool = rayon::ThreadPoolBuilder::new().num_threads(1).build().unwrap();
+    #[cfg(feature = "rayon")]
+    let new_pool = rayon::ThreadPoolBuilder::new().num_threads(threads).build().unwrap();
+    let initial = compare_games(&old, &new);
+    assert!(initial.decision > 0 && initial.terminal > 0);
+    if street < BoardState::River {
+        assert!(initial.chance > 0);
+        assert_eq!(initial.isomorphic > 0, !locked);
+    }
+    assert_eq!(initial.locked, if locked { 2 } else { 0 });
+    for &iteration in iterations {
+        #[cfg(feature = "rayon")]
+        {
+            run_in_pool(&old_pool, || reference::solve_step(&old, iteration));
+            run_in_pool(&new_pool, || crate::solve_step(&new, iteration));
+        }
+        #[cfg(not(feature = "rayon"))]
+        {
+            reference::solve_step(&old, iteration);
+            crate::solve_step(&new, iteration);
+        }
+        // Compare raw words every update; a small EV delta cannot hide an
+        // altered regret, quantization scale, or strategy accumulation path.
+        compare_games(&old, &new);
+        if iteration <= 4 || iteration.is_power_of_two() || Some(&iteration) == iterations.last() {
+            compare_ev(&old, &new);
+        }
+    }
+    finalize(&mut old);
+    finalize(&mut new);
+    compare_games(&old, &new);
+    compare_ev(&old, &new);
+    old.cache_normalized_weights();
+    new.cache_normalized_weights();
+    for player in 0..2 {
+        equal_floats(&old.expected_values(player), &new.expected_values(player), "root per-combo EV");
+        equal_floats(&old.equity(player), &new.equity(player), "root per-combo equity");
+    }
+    equal_floats(&old.strategy(), &new.strategy(), "interpreted root strategy");
+    eprintln!("scratch equivalence {street:?} compressed={compressed} locked/expanded={locked} threads={threads} updates={} nodes={initial:?}", iterations.len());
+}
+
+#[test]
+fn dcfr_scratch_river_contiguous_through_1024_is_bit_exact() {
+    // Genuine contiguous DCFR trajectories, not synthetic jumps, through all
+    // average-strategy reset boundaries up to t=1024. River keeps this small.
+    let iterations: Vec<u32> = (0..1027).collect();
+    for compressed in [false, true] {
+        for locked in [false, true] {
+            equivalence_case(BoardState::River, compressed, locked, if locked { 4 } else { 1 }, &iterations);
+        }
+    }
+}
+
+fn sampled_boundaries() -> Vec<u32> {
+    let mut iterations: Vec<u32> = (0..20).collect();
+    // These jumps test the exact discount parameters around later boundaries;
+    // they are NOT a claim of 1027 consecutive Flop or Turn iterations.
+    iterations.extend([63, 64, 65, 255, 256, 257, 1023, 1024, 1025]);
+    iterations
+}
+
+#[test]
+fn dcfr_scratch_turn_chance_locks_and_zero_reach_are_bit_exact() {
+    for compressed in [false, true] {
+        for locked in [false, true] {
+            equivalence_case(BoardState::Turn, compressed, locked, 1, &sampled_boundaries());
+        }
+    }
+}
+
+#[test]
+fn dcfr_scratch_flop_isomorphic_and_expanded_parallel_are_bit_exact() {
+    for compressed in [false, true] {
+        for locked in [false, true] {
+            equivalence_case(BoardState::Flop, compressed, locked, 4, &sampled_boundaries());
+        }
+    }
+}
+
+
+#[test]
+fn sparse_cfr_matches_dense_words_scales_and_evs() {
+    for street in [BoardState::Flop, BoardState::Turn, BoardState::River] {
+        for compressed in [false,true] {
+            let mut dense=fixture_storage(street,compressed,false,false);
+            let mut sparse=fixture_storage(street,compressed,false,true);
+            assert_eq!(dense.num_private_hands(0),sparse.num_private_hands(0));
+            if street<BoardState::River {assert!(sparse.memory_usage().1<dense.memory_usage().1);}
+            compare_games(&dense,&sparse);
+            // Continuous steps plus actual discount/reset parameters at boundaries.
+            for t in (0..20).chain([63,64,65,255,256,257,1023,1024,1025]) {
+                solve_step(&dense,t);solve_step(&sparse,t);
+                compare_games(&dense,&sparse);
+            }
+            compare_ev(&dense,&sparse);
+            finalize(&mut dense);finalize(&mut sparse);
+            compare_games(&dense,&sparse);
+            compare_ev(&dense,&sparse);
+            dense.cache_normalized_weights();sparse.cache_normalized_weights();
+            equal_floats(&dense.expected_values_detail(0),&sparse.expected_values_detail(0),"sparse node EV");
+            equal_floats(&dense.strategy(),&sparse.strategy(),"sparse node strategy");
+        }
+    }
+}
+
+#[test]
+fn sparse_direct_regret_input_matches_old_sparse_dcfr_at_discount_boundaries() {
+    // The frozen reference still expands packed i16 before converting to f32.
+    // Both sides use sparse storage, so this isolates the new initialization
+    // path from physical-layout differences. This is implementation equivalence,
+    // not an independent terminal evaluator.
+    for street in [BoardState::Flop,BoardState::Turn,BoardState::River] {
+        for threads in [1,4] {
+            let mut old=fixture_storage(street,true,false,true);
+            let mut new=fixture_storage(street,true,false,true);
+            #[cfg(feature="rayon")]
+            let pool=rayon::ThreadPoolBuilder::new().num_threads(threads).build().unwrap();
+            for iteration in sampled_boundaries() {
+                #[cfg(feature="rayon")]
+                pool.install(|| {
+                    reference::solve_step(&old,iteration);
+                    solve_step(&new,iteration);
+                });
+                #[cfg(not(feature="rayon"))]
+                {
+                    let _=threads;
+                    reference::solve_step(&old,iteration);
+                    solve_step(&new,iteration);
+                }
+                compare_games(&old,&new);
+            }
+            compare_ev(&old,&new);
+            finalize(&mut old);finalize(&mut new);
+            compare_games(&old,&new);
+            compare_ev(&old,&new);
+        }
+    }
+}
diff --git a/src/sparse_storage.rs b/src/sparse_storage.rs
new file mode 100644
index 0000000..ba004a9
--- /dev/null
+++ b/src/sparse_storage.rs
@@ -0,0 +1,380 @@
+//! Dense logical views over legal-hand sparse physical storage.
+//!
+//! Every sparse row retains one ghost value for all board-conflicting hands.
+//! In unlocked CFR those entries are identical, including cumulative strategy;
+//! retaining the ghost therefore preserves the original quantization scale.
+//! Writers still quantize the complete dense input before this module scatters
+//! it. After a final opponent policy replaces CFR state, invalid-hand entries
+//! may differ: only their first value is retained, never any legal-hand value.
+//! Such final policy state must not subsequently be used to resume CFR.
+
+use crate::interface::{Game, GameNode};
+use std::{cell::RefCell, fmt, mem::{self, MaybeUninit}, ops::{Deref, DerefMut}};
+
+const MAX_IDLE_BYTES: usize = 1024 * 1024;
+const MAX_IDLE_BUFFERS: usize = 64;
+
+#[derive(Default)]
+struct Pools {
+    floats: Vec<Vec<f32>>,
+    unsigned: Vec<Vec<u16>>,
+    signed: Vec<Vec<i16>>,
+    bytes: usize,
+}
+
+thread_local! {
+    static POOLS: RefCell<Pools> = RefCell::new(Pools::default());
+}
+
+mod sealed {
+    pub trait Sealed {}
+    impl Sealed for f32 {}
+    impl Sealed for u16 {}
+    impl Sealed for i16 {}
+}
+
+/// Storage word supported by the bounded dense-view scratch pool.
+#[doc(hidden)]
+pub trait StorageValue: sealed::Sealed + Copy + Default + 'static {
+    #[doc(hidden)]
+    fn take_buffer(len: usize) -> Vec<Self>;
+    #[doc(hidden)]
+    fn recycle_buffer(buffer: Vec<Self>);
+}
+
+macro_rules! storage_value {
+    ($ty:ty, $field:ident) => {
+        impl StorageValue for $ty {
+            fn take_buffer(len: usize) -> Vec<Self> {
+                let pooled = POOLS.try_with(|pool| {
+                    let mut pool = pool.try_borrow_mut().ok()?;
+                    let index = pool.$field.iter().position(|buffer| buffer.capacity() == len)?;
+                    let buffer = pool.$field.swap_remove(index);
+                    pool.bytes -= buffer.capacity() * mem::size_of::<Self>();
+                    Some(buffer)
+                }).ok().flatten();
+                let mut buffer = pooled.unwrap_or_else(|| Vec::with_capacity(len));
+                buffer.resize(len, Self::default());
+                buffer
+            }
+
+            fn recycle_buffer(buffer: Vec<Self>) {
+                let bytes = buffer.capacity() * mem::size_of::<Self>();
+                if bytes == 0 || bytes > MAX_IDLE_BYTES { return; }
+                // Preserve initialized length. An exact-capacity checkout can
+                // then skip resize's zero fill; expand overwrites every element
+                // with its row ghost and all legal-hand values before exposure.
+                // An active checkout owns its buffer; no pool borrow survives
+                // recursion or Rayon work. TLS teardown/borrow conflicts free
+                // the buffer normally instead of panicking or retaining it.
+                let _ = POOLS.try_with(move |pool| {
+                    if let Ok(mut pool) = pool.try_borrow_mut() {
+                        let count = pool.floats.len() + pool.unsigned.len() + pool.signed.len();
+                        if pool.bytes + bytes <= MAX_IDLE_BYTES && count < MAX_IDLE_BUFFERS {
+                            pool.bytes += bytes;
+                            pool.$field.push(buffer);
+                        }
+                    }
+                });
+            }
+        }
+    }
+}
+storage_value!(f32, floats);
+storage_value!(u16, unsigned);
+storage_value!(i16, signed);
+
+struct Buffer<T: StorageValue>(Vec<T>);
+impl<T: StorageValue> Drop for Buffer<T> {
+    fn drop(&mut self) { T::recycle_buffer(mem::take(&mut self.0)); }
+}
+
+enum ReadInner<'a, T: StorageValue> {
+    Borrowed(&'a [T]),
+    Expanded(Buffer<T>),
+}
+
+/// Read-only dense hand/action ordering. A dense game is borrowed without copying.
+pub struct StorageRead<'a, T: StorageValue>(ReadInner<'a, T>);
+
+impl<T: StorageValue> Deref for StorageRead<'_, T> {
+    type Target = [T];
+    fn deref(&self) -> &[T] {
+        match &self.0 { ReadInner::Borrowed(values) => values, ReadInner::Expanded(values) => &values.0 }
+    }
+}
+impl<T: StorageValue + fmt::Debug> fmt::Debug for StorageRead<'_, T> {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result { self.deref().fmt(f) }
+}
+
+enum WriteInner<'a, T: StorageValue> {
+    Borrowed(&'a mut [T]),
+    Expanded {
+        packed: &'a mut [T],
+        indices: &'a [u16],
+        hands: usize,
+        first_invalid: usize,
+        dense: Buffer<T>,
+    },
+}
+
+/// Mutable dense view. Dropping it writes every legal hand and its row's ghost
+/// back to the uniquely borrowed packed slice. Drop this guard before updating
+/// other node fields such as its compression scale.
+pub struct StorageWrite<'a, T: StorageValue>(WriteInner<'a, T>);
+
+impl<T: StorageValue> Deref for StorageWrite<'_, T> {
+    type Target = [T];
+    fn deref(&self) -> &[T] {
+        match &self.0 { WriteInner::Borrowed(values) => values, WriteInner::Expanded { dense, .. } => &dense.0 }
+    }
+}
+impl<T: StorageValue> DerefMut for StorageWrite<'_, T> {
+    fn deref_mut(&mut self) -> &mut [T] {
+        match &mut self.0 { WriteInner::Borrowed(values) => values, WriteInner::Expanded { dense, .. } => &mut dense.0 }
+    }
+}
+impl<T: StorageValue + fmt::Debug> fmt::Debug for StorageWrite<'_, T> {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result { self.deref().fmt(f) }
+}
+impl<T: StorageValue> Drop for StorageWrite<'_, T> {
+    fn drop(&mut self) {
+        if let WriteInner::Expanded { packed, indices, hands, first_invalid, dense } = &mut self.0 {
+            let width = indices.len() + 1;
+            for (destination, source) in packed.chunks_exact_mut(width).zip(dense.0.chunks_exact(*hands)) {
+                for (value, &index) in destination.iter_mut().zip(indices.iter()) {
+                    *value = source[index as usize];
+                }
+                destination[indices.len()] = source[*first_invalid];
+            }
+        }
+    }
+}
+
+fn expand<T: StorageValue>(packed: &[T], indices: &[u16], hands: usize, rows: usize) -> Buffer<T> {
+    let width = indices.len() + 1;
+    assert_eq!(packed.len(), rows * width, "sparse physical storage shape mismatch");
+    debug_assert!(indices.windows(2).all(|pair| pair[0] < pair[1]));
+    debug_assert!(indices.iter().all(|&index| (index as usize) < hands));
+    let mut dense = Buffer(T::take_buffer(rows * hands));
+    for (source, destination) in packed.chunks_exact(width).zip(dense.0.chunks_exact_mut(hands)) {
+        destination.fill(source[indices.len()]);
+        for (&value, &index) in source.iter().zip(indices) { destination[index as usize] = value; }
+    }
+    dense
+}
+
+/// Initializes the full logical f32 regret-matching input directly from packed
+/// i16 rows. This replaces expand-to-i16 followed by positive conversion; it
+/// does not change which hands enter normalization or their action ordering.
+/// Every output cell is initialized, including all copies of the row's ghost.
+#[inline]
+pub(crate) fn positive_packed_regrets(
+    packed: &[i16], indices: &[u16], hands: usize, rows: usize,
+    output: &mut [MaybeUninit<f32>],
+) {
+    assert!(indices.len() < hands, "packed regret input needs a ghost column");
+    let width = indices.len() + 1;
+    assert_eq!(packed.len(), rows * width, "packed regret shape mismatch");
+    assert_eq!(output.len(), rows * hands, "logical regret shape mismatch");
+    debug_assert!(indices.windows(2).all(|pair| pair[0] < pair[1]));
+    for (source, destination) in packed.chunks_exact(width).zip(output.chunks_exact_mut(hands)) {
+        destination.fill(MaybeUninit::new(source[indices.len()].max(0) as f32));
+        for (&value, &index) in source.iter().zip(indices) {
+            destination[index as usize].write(value.max(0) as f32);
+        }
+    }
+}
+
+fn read_view<'a, T: StorageValue>(packed: &'a [T], indices: Option<&[u16]>, hands: usize, rows: usize) -> StorageRead<'a, T> {
+    match indices {
+        Some(indices) if indices.len() < hands && !packed.is_empty() => {
+            StorageRead(ReadInner::Expanded(expand(packed, indices, hands, rows)))
+        }
+        _ => StorageRead(ReadInner::Borrowed(packed)),
+    }
+}
+
+fn write_view<'a, T: StorageValue>(packed: &'a mut [T], indices: Option<&'a [u16]>, hands: usize, rows: usize) -> StorageWrite<'a, T> {
+    match indices {
+        Some(indices) if indices.len() < hands && !packed.is_empty() => {
+            let first_invalid = indices.iter().enumerate().find_map(|(i, &index)| (i != index as usize).then_some(i)).unwrap_or(indices.len());
+            let dense = expand(packed, indices, hands, rows);
+            StorageWrite(WriteInner::Expanded { packed, indices, hands, first_invalid, dense })
+        }
+        _ => StorageWrite(WriteInner::Borrowed(packed)),
+    }
+}
+
+macro_rules! action_views {
+    ($read:ident, $write:ident, $raw_read:ident, $raw_write:ident, $ty:ty) => {
+        #[doc = "Returns dense action-major storage in the unchanged private-hand ordering."]
+        #[inline]
+        pub fn $read<'a, G: Game>(game: &'a G, node: &'a G::Node) -> StorageRead<'a, $ty> {
+            let player = node.player();
+            read_view(node.$raw_read(), game.storage_hand_indices(node, player), game.num_private_hands(player), node.num_actions())
+        }
+        #[doc = "Returns mutable dense action-major storage; drop before changing the node's scale."]
+        #[inline]
+        pub fn $write<'a, G: Game>(game: &'a G, node: &'a mut G::Node) -> StorageWrite<'a, $ty> {
+            let player = node.player();
+            let rows = node.num_actions();
+            let indices = game.storage_hand_indices(node, player);
+            write_view(node.$raw_write(), indices, game.num_private_hands(player), rows)
+        }
+    }
+}
+action_views!(dense_strategy, dense_strategy_mut, strategy, strategy_mut, f32);
+action_views!(dense_regrets, dense_regrets_mut, regrets, regrets_mut, f32);
+action_views!(dense_cfvalues, dense_cfvalues_mut, cfvalues, cfvalues_mut, f32);
+action_views!(dense_strategy_compressed, dense_strategy_compressed_mut, strategy_compressed, strategy_compressed_mut, u16);
+action_views!(dense_regrets_compressed, dense_regrets_compressed_mut, regrets_compressed, regrets_compressed_mut, i16);
+action_views!(dense_cfvalues_compressed, dense_cfvalues_compressed_mut, cfvalues_compressed, cfvalues_compressed_mut, i16);
+
+fn ip_player<N: GameNode>(_: &N) -> usize { 1 }
