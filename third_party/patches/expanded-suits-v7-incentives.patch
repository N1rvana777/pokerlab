+
+macro_rules! single_views {
+    ($read:ident, $write:ident, $raw_read:ident, $raw_write:ident, $ty:ty, $player:ident) => {
+        #[doc = "Returns a dense single-player counterfactual-value row."]
+        #[inline]
+        pub fn $read<'a, G: Game>(game: &'a G, node: &'a G::Node) -> StorageRead<'a, $ty> {
+            let player = $player(node);
+            read_view(node.$raw_read(), game.storage_hand_indices(node, player), game.num_private_hands(player), 1)
+        }
+        #[doc = "Returns a mutable dense single-player counterfactual-value row."]
+        #[inline]
+        pub fn $write<'a, G: Game>(game: &'a G, node: &'a mut G::Node) -> StorageWrite<'a, $ty> {
+            let player = $player(&*node);
+            let indices = game.storage_hand_indices(node, player);
+            write_view(node.$raw_write(), indices, game.num_private_hands(player), 1)
+        }
+    }
+}
