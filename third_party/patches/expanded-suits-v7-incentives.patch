+            let cfreach_i = cfreach[i as usize] as f64;
+            if cfreach_i != 0.0 {
+                let (c1, c2) = self.private_cards[player ^ 1][i as usize];
+                cfreach_sum += cfreach_i;
+                cfreach_minus[c1 as usize] += cfreach_i;
+                cfreach_minus[c2 as usize] += cfreach_i;
+            }
+        }
+        if cfreach_sum == 0.0 {
+            return;
+        }
