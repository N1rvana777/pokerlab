+        let num_hands = self.private_cards[player].len();
+        let same_hand_index = &self.same_hand_index[player];
+        for (action, child) in children.iter().enumerate() {
+            let rate = match child.lock().prev_action {
+                Action::Check => incentive.check,
+                Action::Fold => incentive.fold,
+                Action::Call => incentive.call,
+                _ => incentive.bet,
+            } as f64;
