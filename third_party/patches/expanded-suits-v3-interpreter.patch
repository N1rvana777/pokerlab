+    #[test]
+    fn interpreter_checkpoint_restores_solved_value_caches() {
+        let cards = CardConfig {
+            range: ["AA,AKs,QQ".parse().unwrap(), "JJ,TT,KQs".parse().unwrap()],
+            flop: flop_from_str("9h8h2h").unwrap(),
+            turn: card_from_str("3d").unwrap(),
+            river: card_from_str("4s").unwrap(),
+        };
+        let tree = ActionTree::new(TreeConfig {
+            initial_state: BoardState::River,
+            starting_pot: 20,
+            effective_stack: 40,
+            river_bet_sizes: [("50%", "").try_into().unwrap(), ("50%", "").try_into().unwrap()],
+            ..Default::default()
+        }).unwrap();
+        let mut game = PostFlopGame::with_config(cards, tree).unwrap();
+        game.allocate_memory(true);
+        finalize(&mut game);
+        choose(&mut game, |a| matches!(a, Action::Bet(_)));
+        game.cache_normalized_weights();
+        assert!(game.cfvalues_cache[0].iter().any(|&v| v != 0.0));
+        let expected = [game.expected_values(0), game.expected_values(1)];
+        let parent = game.checkpoint_interpreter();
+        game.back_to_root();
+        choose(&mut game, |a| *a == Action::Check);
+        choose(&mut game, |a| matches!(a, Action::Bet(_)));
+        game.cache_normalized_weights();
+        game.restore_interpreter(&parent);
+        assert_eq!(game.checkpoint_interpreter(), parent);
+        assert_eq!([game.expected_values(0), game.expected_values(1)], expected);
+    }
