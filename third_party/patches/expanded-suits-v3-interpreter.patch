+    fn game(compressed: bool, expanded: bool) -> PostFlopGame {
+        let cards = CardConfig {
+            range: ["AA,AKs,QQ".parse().unwrap(), "JJ,TT,KQs".parse().unwrap()],
+            flop: flop_from_str("9h8h2h").unwrap(),
+            ..Default::default()
+        };
+        let sizing = || ("50%", "").try_into().unwrap();
+        let tree = ActionTree::new(TreeConfig {
+            starting_pot: 20,
+            effective_stack: 40,
+            flop_bet_sizes: [sizing(), sizing()],
+            turn_bet_sizes: [sizing(), sizing()],
+            river_bet_sizes: [sizing(), sizing()],
+            ..Default::default()
+        }).unwrap();
+        let mut game = if expanded {
+            PostFlopGame::with_config_unmerged(cards, tree).unwrap()
+        } else {
+            PostFlopGame::with_config(cards, tree).unwrap()
+        };
+        game.allocate_memory(compressed);
+        game
+    }
+
+    fn choose(game: &mut PostFlopGame, matches: impl Fn(&Action) -> bool) -> usize {
+        let action = game.available_actions().iter().position(matches).unwrap();
+        game.play(action);
+        action
+    }
