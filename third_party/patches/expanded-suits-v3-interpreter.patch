+    /// [arena bytes, action elements, IP elements, chance elements, card/misc bytes,
+    /// opponent lock elements, opponent lock nodes]. No expanded nodes allocated.
+    pub fn memory_plan(&self, opponent: usize) -> [u64; 7] {
+        fn visit(node: &ActionTreeNode, fresh: bool, hands: [u64;2], opponent: usize, rows: &mut [[u64;5];3]) {
+            if node.player & PLAYER_TERMINAL_FLAG != 0 {return;}
+            let row=&mut rows[node.board_state as usize];
+            if node.player & PLAYER_CHANCE_FLAG != 0 {
+                let previous=node.player & PLAYER_MASK;
+                if previous < 2 {row[2]+=hands[(previous ^ 1) as usize];}
+            } else {
+                let n=node.actions.len() as u64*hands[node.player as usize];
+                row[0]+=n;
+                if fresh {row[1]+=hands[1];}
+                if node.player as usize==opponent {row[3]+=n;row[4]+=1;}
+            }
+            for child in &node.children {visit(&child.lock(),node.player & PLAYER_CHANCE_FLAG != 0,hands,opponent,rows);}
+        }
+        let nodes=self.count_num_nodes();
+        let public=count_num_action_nodes(&self.action_root.lock());
+        let mut rows=[[0;5];3];
+        visit(&self.action_root.lock(),true,[self.private_cards[0].len() as u64,self.private_cards[1].len() as u64],opponent,&mut rows);
+        let mut sums=[0;5];
+        for s in 0..3 {let factor=if public[s]==0 {0}else{nodes[s]/public[s]};for i in 0..5 {sums[i]+=rows[s][i]*factor;}}
+        [nodes.iter().sum::<u64>()*mem::size_of::<MutexLike<PostFlopNode>>() as u64,
+         sums[0],sums[1],sums[2],self.memory_usage_internal(),sums[3],sums[4]]
+    }
