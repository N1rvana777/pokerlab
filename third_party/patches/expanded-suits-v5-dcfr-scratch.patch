+    #[test]
+    fn interpreter_checkpoint_preserves_descendant_edits_and_matches_replay() {
+        for compressed in [false, true] {
+            for expanded in [false, true] {
+                let mut game = game(compressed, expanded);
+                let hands = game.private_cards(0).len();
+                // A suit-symmetric non-uniform root policy exercises conditional reach.
+                let mut root_strategy = vec![0.25; hands * 2];
+                root_strategy[hands..].fill(0.75);
+                game.lock_current_strategy(&root_strategy);
+                choose(&mut game, |a| matches!(a, Action::Bet(_)));
+                choose(&mut game, |a| *a == Action::Call);
+                game.play(card_from_str("3d").unwrap() as usize);
+                if !expanded { assert!(game.turn_swap.is_some()); }
+                choose(&mut game, |a| matches!(a, Action::Bet(_)));
+
+                let actions = game.available_actions();
+                let hands = game.private_cards(game.current_player()).len();
+                let mut locked = vec![0.0; hands * actions.len()];
+                let fold = actions.iter().position(|a| *a == Action::Fold).unwrap();
+                let call = actions.iter().position(|a| *a == Action::Call).unwrap();
+                locked[fold * hands..(fold + 1) * hands].fill(0.4);
+                locked[call * hands..(call + 1) * hands].fill(0.6);
+                game.lock_current_strategy(&locked);
+                game.cache_normalized_weights();
+                let parent = game.checkpoint_interpreter();
+                assert!(parent.is_normalized_weight_cached);
+                assert!(parent.total_bet_amount[0] > parent.total_bet_amount[1]);
+
+                game.play(call);
+                let uncached = game.checkpoint_interpreter();
+                assert!(!uncached.is_normalized_weight_cached);
+                game.cache_normalized_weights();
+                game.restore_interpreter(&uncached);
+                assert_eq!(game.checkpoint_interpreter(), uncached);
+                game.play(card_from_str("4s").unwrap() as usize);
+                if !expanded { assert!(game.river_swap.is_some()); }
+                let leaf_path = game.history().to_vec();
+                let hands = game.private_cards(game.current_player()).len();
+                let mut edited = vec![0.0; hands * game.available_actions().len()];
+                edited[..hands].fill(1.0);
+                game.replace_current_strategy(&edited);
+                let expected_strategy = game.strategy();
+                game.cache_normalized_weights();
+                let river = game.checkpoint_interpreter();
+                choose(&mut game, |a| *a == Action::Check);
+                game.restore_interpreter(&river);
+                assert_eq!(game.checkpoint_interpreter(), river);
+
+                game.restore_interpreter(&parent);
+                assert_eq!(game.checkpoint_interpreter(), parent);
+                assert_eq!(game.current_locking_strategy().unwrap(), locked);
+                game.apply_history(&leaf_path);
+                assert_eq!(game.strategy(), expected_strategy);
+                // Replay uses the edited descendant policy, but it must not change
+                // reach at this unchanged ancestor or undo the descendant edits.
+                game.apply_history(&parent.action_history);
+                game.cache_normalized_weights();
+                assert_eq!(game.checkpoint_interpreter(), parent);
+                game.apply_history(&leaf_path);
+                assert_eq!(game.strategy(), expected_strategy);
+            }
+        }
+    }
