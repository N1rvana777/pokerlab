+        let mut game = game(true, false);
+        let hands = game.private_cards(0).len();
+        let mut locked = vec![0.0; hands * 2];
+        locked[..hands].fill(1.0);
+        game.lock_current_strategy(&locked);
+        choose(&mut game, |a| matches!(a, Action::Bet(_)));
+        assert!(game.weights(0).iter().all(|&w| w == 0.0));
+        game.cache_normalized_weights();
+        let zero = game.checkpoint_interpreter();
+        choose(&mut game, |a| *a == Action::Call);
+        game.play(card_from_str("3d").unwrap() as usize);
+        game.cache_normalized_weights();
+        game.restore_interpreter(&zero);
+        assert_eq!(game.checkpoint_interpreter(), zero);
+        game.apply_history(&zero.action_history);
+        game.cache_normalized_weights();
+        assert_eq!(game.checkpoint_interpreter(), zero);
+
+        let mut other = self::game(true, false);
+        let rejected = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            other.restore_interpreter(&zero);
+        }));
+        assert!(rejected.is_err());
+    }
