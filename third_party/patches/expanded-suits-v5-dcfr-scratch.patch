 impl PostFlopGame {
+    /// Saves the interpreter state in O(number of private hands + history depth).
+    ///
+    /// Capture after editing the current strategy, then use this checkpoint to
+    /// return from descendant visits without replaying every ancestor action.
+    pub fn checkpoint_interpreter(&self) -> InterpreterCheckpoint {
+        assert!(self.state > State::Uninitialized, "Game is not successfully initialized");
+        InterpreterCheckpoint {
+            arena_address: self.node_arena.as_ptr() as usize,
+            arena_len: self.node_arena.len(),
+            storage_address: self.storage1.as_ptr() as usize,
+            game_state: self.state as u8,
+            action_history: self.action_history.clone(),
+            node_history: self.node_history.clone(),
+            is_normalized_weight_cached: self.is_normalized_weight_cached,
+            turn: self.turn,
+            river: self.river,
+            turn_swapped_suit: self.turn_swapped_suit,
+            turn_swap: self.turn_swap,
+            river_swap: self.river_swap,
+            total_bet_amount: self.total_bet_amount,
+            weights: self.weights.clone(),
+            normalized_weights: self.normalized_weights.clone(),
+            cfvalues_cache: self.cfvalues_cache.clone(),
+        }
+    }
+
+    /// Restores only the interpreter cursor/reach/cache, leaving all policies intact.
+    ///
+    /// The checkpoint is invalid after configuration, allocation, or solving-state
+    /// changes. It also must not be used after editing an ancestor's policy: its
+    /// stored reach would then describe the old ancestor policy.
+    pub fn restore_interpreter(&mut self, checkpoint: &InterpreterCheckpoint) {
+        assert!(
+            self.state > State::Uninitialized
+                && self.state as u8 == checkpoint.game_state
+                && self.node_arena.as_ptr() as usize == checkpoint.arena_address
+                && self.node_arena.len() == checkpoint.arena_len
+                && self.storage1.as_ptr() as usize == checkpoint.storage_address,
+            "Interpreter checkpoint belongs to a different or rebuilt game"
+        );
+        self.action_history.clone_from(&checkpoint.action_history);
+        self.node_history.clone_from(&checkpoint.node_history);
+        self.is_normalized_weight_cached = checkpoint.is_normalized_weight_cached;
+        self.turn = checkpoint.turn;
+        self.river = checkpoint.river;
+        self.turn_swapped_suit = checkpoint.turn_swapped_suit;
+        self.turn_swap = checkpoint.turn_swap;
+        self.river_swap = checkpoint.river_swap;
+        self.total_bet_amount = checkpoint.total_bet_amount;
+        for player in 0..2 {
+            self.weights[player].clone_from(&checkpoint.weights[player]);
+            self.normalized_weights[player].clone_from(&checkpoint.normalized_weights[player]);
+            self.cfvalues_cache[player].clone_from(&checkpoint.cfvalues_cache[player]);
+        }
+    }
